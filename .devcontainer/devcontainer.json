{
    "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
    "customizations": {
        "vscode": {
            "extensions": [
                "aaron-bond.better-comments",
                "charliermarsh.ruff",
                "christian-kohler.path-intellisense",
                "fosshaas.fontsize-shortcuts",
                "GitHub.vscode-pull-request-github",
                "IgorSbitnev.error-gutters",
                "maattdd.gitless",
                "ms-python.mypy-type-checker",
                "oderwat.indent-rainbow",
                "seunlanlege.action-buttons",
                "SirTori.indenticator",
                "usernamehw.errorlens",
                "vsls-contrib.gitdoc",
                "yzhang.markdown-all-in-one"
            ],
            "settings": {
                "[markdown]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "[python]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "charliermarsh.ruff"
                },
                "gitlens.showWhatsNewAfterUpgrades": false,
                "gitlens.showWelcomeOnInstall": false,
                "editor.wordWrap": "on",
                "editor.inlayHints.enabled": "off",
                "editor.fontSize": 18,
                "editor.rulers": [
                    80
                ],
                "editor.tokenColorCustomizations": {
                    "textMateRules": [
                        {
                            "scope": "comment",
                            "settings": {
                                "fontStyle": "italic"
                            }
                        }
                    ]
                },
                "gitdoc.commitValidationLevel": "none",
                "gitdoc.enabled": true,
                "chat.disableAIFeatures": true,
                "mypy-type-checker.args": ["--config-file=${workspaceFolder}/.config/mypy.toml"],
                "mypy-type-checker.interpreter": ["/usr/local/bin/python3"],
                "python.analysis.typeCheckingMode": "off",
                "pylint.args": ["--rcfile=${workspaceFolder}/.config/pylint.toml"],
                "pylint.cwd": "${workspaceFolder}",
                "pylint.enabled": true,
                "pylint.ignorePatterns": ["**/.config/**"],
                "pylint.importStrategy": "fromEnvironment",
                "pylint.interpreter": ["/usr/local/bin/python3"],
                "pylint.lintOnChange": true,
                "ruff.format.preview": true,
                "ruff.lint.preview": true,
                "ruff.configuration": ".config/ruff.toml",
                "workbench.colorTheme": "Light 2026",
                "actionButtons": {
                    "commands": [
                        {
                            "cwd": "{workspaceFolder}",
                            "name": "$(play) Run",
                            "useVsCodeApi": true,
                            "command": "workbench.action.debug.start"
                        },
                        {
                            "cwd": "{workspaceFolder}",
                            "name": "$(pencil) Format",
                            "useVsCodeApi": true,
                            "command": "editor.action.formatDocument"
                        },
                        {
                            "cwd": "${workspaceFolder}",
                            "name": "$(terminal-view-icon) New term",
                            "useVsCodeApi": true,
                            "command": "workbench.action.terminal.newInActiveWorkspace"
                        },
                        {
                            "name": "$(terminal-kill) Kill terms",
                            "useVsCodeApi": true,
                            "command": "workbench.action.terminal.killAll"
                        }
                    ],
                    "defaultColor": "none",
                    "reloadButton": "↻",
                    "loadNpmCommands": false
                }
            }
        }
    }
}